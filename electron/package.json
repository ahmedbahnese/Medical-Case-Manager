{
  "name": "bsch-desktop",
  "version": "1.0.0",
  "description": "BSCH Hospital Case Management System - Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-installer": "electron-builder --win nsis",
    "build-portable": "electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.bsch.hospital",
    "productName": "BSCH",
    "copyright": "مستشفى الأطفال التخصصي بالبحيرة",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html"
    ],
    "extraResources": [
      {
        "from": "../artifacts/api-server/dist",
        "to": "api-server/dist"
      },
      {
        "from": "../artifacts/bsch/dist/public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BSCH",
      "deleteAppDataOnUninstall": false,
      "license": null
    },
    "portable": {
      "artifactName": "BSCH-Portable-${version}.exe"
    },
    "artifactName": "BSCH-Setup-${version}.exe"
  }
}
