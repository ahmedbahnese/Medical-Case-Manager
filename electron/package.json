{
  "name": "bsch-desktop",
  "version": "1.0.0",
  "description": "BSCH Hospital Case Management System - Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --publish never",
    "build-installer": "electron-builder --win nsis --publish never",
    "build-portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.bsch.hospital",
    "productName": "BSCH",
    "copyright": "مستشفى الأطفال التخصصي بالبحيرة",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html"
    ],
    "extraResources": [
      {
        "from": "../artifacts/api-server/dist",
        "to": "api-server/dist"
      },
      {
        "from": "../lib/db/node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3"
      },
      {
        "from": "../node_modules/.pnpm/bindings@1.5.0/node_modules/bindings",
        "to": "node_modules/bindings"
      },
      {
        "from": "../node_modules/.pnpm/file-uri-to-path@1.0.0/node_modules/file-uri-to-path",
        "to": "node_modules/file-uri-to-path"
      },
      {
        "from": "../assets/tesseract-runtime/node_modules",
        "to": "node_modules"
      },
      {
        "from": "../artifacts/bsch/dist/public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64", "ia32"] },
        { "target": "portable", "arch": ["x64", "ia32"] }
      ],
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BSCH",
      "deleteAppDataOnUninstall": false,
      "license": null
    },
    "portable": {
      "artifactName": "BSCH-Portable-${arch}-${version}.exe"
    },
    "artifactName": "BSCH-Setup-${arch}-${version}.exe",
    "publish": []
  }
}
