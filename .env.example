# ============================================================
# BSCH — نظام إدارة الحالات الطبية
# Environment Variables Example
# Copy this file to .env and fill in real values.
# ============================================================

# ----------------------------
# API Server
# ----------------------------

# TCP port the API server listens on
PORT=8080

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://bsch_user:change_me@localhost:5432/bsch_db

# Session secret used to sign cookies (generate a strong random string)
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Fallback founder password (overridden by the value stored in the database)
# Change this immediately after first login via the Settings page.
FOUNDER_PASSWORD=bsch2024

# ----------------------------
# Frontend (Vite)
# ----------------------------

# Base path (use / for root deployment, or /bsch for a sub-path)
BASE_PATH=/

# API base URL that the frontend calls (must match the API server address)
VITE_API_URL=http://localhost:8080

# ----------------------------
# Optional: Docker / Production
# ----------------------------
# NODE_ENV=production
