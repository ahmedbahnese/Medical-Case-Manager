# ============================================================
# BSCH — نظام إدارة الحالات الطبية
# Environment Variables — copy this file to .env and fill in real values
# ============================================================

# ----------------------------
# API Server
# ----------------------------

# TCP port the API server listens on
PORT=8080

# Node environment (development | production)
NODE_ENV=production

# ----------------------------
# MySQL Database (replaces PostgreSQL)
# ----------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bsch_user
DB_PASSWORD=change_me
DB_NAME=bsch_db

# Session secret — used to sign the session cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Founder (admin) password — the main login password for the system
# Change this immediately after first login via the Settings page.
FOUNDER_PASSWORD=bsch2024

# Settings page password — required to change sensitive system settings
SETTINGS_PASSWORD=change_me_settings_password

# Log level (trace | debug | info | warn | error | fatal) — default: info
LOG_LEVEL=info

# ----------------------------
# Frontend (Vite build)
# ----------------------------

# Base path for the frontend (use / for root deployment)
BASE_PATH=/

# Path to the built frontend public directory (used by Express in production)
# Leave blank to use the default monorepo path
FRONTEND_DIR=

# ----------------------------
# Electron Desktop App
# ----------------------------
# When running as a packaged Electron app, database credentials are read from:
#   %APPDATA%\BSCH\bsch.config.json
# Example bsch.config.json:
#   {
#     "DB_HOST": "127.0.0.1",
#     "DB_PORT": "3306",
#     "DB_USER": "bsch_user",
#     "DB_PASSWORD": "your_password_here",
#     "DB_NAME": "bsch_db"
#   }
