# ============================================================
# BSCH — نظام إدارة الحالات الطبية
# Environment Variables — copy this file to .env and fill in real values
# ============================================================

# ----------------------------
# API Server
# ----------------------------

# TCP port the API server listens on (use 80 for LAN production, 8080 for dev)
PORT=8080

# Node environment (development | production)
NODE_ENV=production

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://bsch_user:change_me@localhost:5432/bsch_db

# Session secret — used to sign the session cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. KEEP THIS SECRET.
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Founder (admin) password — the main login password for the system
# Change this immediately after first login via the Settings page.
# This value is the FALLBACK; once changed in-app it is stored in the database.
FOUNDER_PASSWORD=bsch2024

# Settings page password — required to change sensitive system settings
# Defaults to "@Bahnasy" if not set. Change this for production.
SETTINGS_PASSWORD=change_me_settings_password

# Log level (trace | debug | info | warn | error | fatal) — default: info
LOG_LEVEL=info

# ----------------------------
# Frontend (Vite build)
# ----------------------------

# Base path for the frontend (use / for root deployment, /bsch for sub-path)
BASE_PATH=/

# ----------------------------
# Windows Batch Scripts (Backup.bat / Restore.bat)
# These are separate from DATABASE_URL — used by pg_dump/psql directly
# ----------------------------

DB_HOST=localhost
DB_PORT=5432
DB_USER=bsch_user
DB_PASSWORD=change_me
DB_NAME=bsch_db

# ----------------------------
# Docker / Production (docker-compose.yml)
# ----------------------------

# Password for the PostgreSQL container user (bsch_user)
# DB_PASSWORD=change_me_in_production

# Port to expose the application on the host
# APP_PORT=80
